# Partalog AI chat service production template
# Use this for the lightweight Cloud Run service built from Dockerfile.chat.
# Put real values in Secret Manager / Cloud Run env, not in git.

APP_NAME=Partalog AI Chat Service
APP_VERSION=2.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Chat image profile: no YOLO/catalog-processing model loading in this service.
STARTUP_SKIP_MODEL_LOADING=true
ENABLE_HOTSPOT_ENDPOINTS=false
ENABLE_CATALOG_PROCESSING_ENDPOINTS=false

# Vertex AI is the production default. The Cloud Run service account supplies ADC.
GENAI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=CHANGE_ME_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash-lite
GENAI_REQUEST_TIMEOUT_SECONDS=30
GENAI_STREAM_TIMEOUT_SECONDS=90
GENAI_RETRY_ATTEMPTS=2
GENAI_RETRY_BASE_DELAY_SECONDS=0.5

# Database / pgvector access
DB_CONNECTION_STRING=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/KatalogcuDb

# Distributed chat capacity. Redis is required for multi-instance production.
AI_CHAT_GLOBAL_CONCURRENCY=100
AI_CHAT_ACQUIRE_TIMEOUT_SECONDS=0.5
AI_CHAT_CAPACITY_PROVIDER=redis
AI_CHAT_USE_DISTRIBUTED_LEASES=true
AI_CHAT_REDIS_URL=redis://CHANGE_ME_REDIS_HOST:6379/0
AI_CHAT_REDIS_KEY_PREFIX=partalog:ai-capacity
AI_CHAT_DISTRIBUTED_LEASE_TTL_SECONDS=180
AI_CHAT_DISTRIBUTED_POOL_NAME=python-chat

# Storage for feedback images / visual assets when enabled.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=CHANGE_ME_ASSETS_BUCKET
STORAGE_BASE_URL=https://storage.googleapis.com/CHANGE_ME_ASSETS_BUCKET
STORAGE_S3_ENDPOINT=https://storage.googleapis.com
STORAGE_ACCESS_KEY=CHANGE_ME_IF_USING_INTEROPERABILITY
STORAGE_SECRET_KEY=CHANGE_ME_IF_USING_INTEROPERABILITY
STORAGE_REGION=auto
