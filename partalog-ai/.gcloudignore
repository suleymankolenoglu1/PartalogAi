# Cloud Build source filters for partalog-ai
#
# Important: we intentionally include the production YOLO weights even though
# the local .gitignore excludes generic model files (*.pt).

.git
.gitignore
__pycache__/
*.py[cod]
venv/
.venv/
env/
.env
.DS_Store
debug/
debug_dumps/
output/
eval/report*.json
eval/report*.md
visual_debug.log

# Keep the production model in the build context.
!models/
!models/best.pt
