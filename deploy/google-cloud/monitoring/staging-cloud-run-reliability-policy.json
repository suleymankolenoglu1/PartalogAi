{
  "displayName": "Partalog staging Cloud Run reliability",
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "API 5xx rate above 0.01 per second",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND metric.type = \"run.googleapis.com/request_count\" AND resource.label.service_name = \"partalog-api-staging\" AND metric.label.response_code_class = \"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.label.service_name"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.01,
        "duration": "60s",
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "AI service 5xx rate above 0.01 per second",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND metric.type = \"run.googleapis.com/request_count\" AND resource.label.service_name = \"partalog-ai-chat-staging\" AND metric.label.response_code_class = \"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.label.service_name"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.01,
        "duration": "60s",
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "API p95 request latency above 5 seconds",
      "conditionThreshold": {
        "filter": "resource.type = \"cloud_run_revision\" AND metric.type = \"run.googleapis.com/request_latencies\" AND resource.label.service_name = \"partalog-api-staging\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_MAX",
            "groupByFields": [
              "resource.label.service_name"
            ]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 5000,
        "duration": "120s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "documentation": {
    "content": "Staging Cloud Run reliability incident. Inspect API and AI revision logs, Vertex quota responses, Cloud SQL/Redis health and recent deployment changes.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "environment": "staging",
    "release_gate": "catalog_chat"
  }
}
