{
  "displayName": "Partalog staging public availability",
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "API readiness uptime below 100% for 2 minutes",
      "conditionThreshold": {
        "filter": "resource.type = \"uptime_url\" AND metric.type = \"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.label.check_id = \"partalog-staging-api-readiness-1lys4ys7Jlc\"",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_FRACTION_TRUE",
            "crossSeriesReducer": "REDUCE_MIN"
          }
        ],
        "comparison": "COMPARISON_LT",
        "thresholdValue": 1,
        "duration": "120s",
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "Web uptime below 100% for 2 minutes",
      "conditionThreshold": {
        "filter": "resource.type = \"uptime_url\" AND metric.type = \"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.label.check_id = \"partalog-staging-web-availability-iCO1RdOLYqA\"",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_FRACTION_TRUE",
            "crossSeriesReducer": "REDUCE_MIN"
          }
        ],
        "comparison": "COMPARISON_LT",
        "thresholdValue": 1,
        "duration": "120s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "documentation": {
    "content": "Staging public availability incident. Check Cloud Run revisions, API /health/ready, Cloud SQL and Redis readiness before retrying deployment or load gates.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "environment": "staging",
    "release_gate": "catalog_chat"
  }
}
