# Catalog-only production environment template
# Copy to your server secret manager or .env (do not commit real values).

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=KatalogcuDb;Username=postgres;Password=CHANGE_ME

JwtSettings__SecretKey=CHANGE_ME_MIN_32_CHARS
JwtSettings__Issuer=KatalogcuAPI
JwtSettings__Audience=KatalogcuFrontend
JwtSettings__ExpirationMinutes=60

PublicLink__SecretKey=CHANGE_ME_MIN_32_CHARS
PublicLink__Issuer=KatalogcuPublic
PublicLink__Audience=KatalogcuPublic
PublicLink__ExpirationDays=365

Cors__AllowedOrigins__0=https://your-frontend-domain.com

RequestLimits__DefaultMaxBodySizeMb=50

AiService__BaseUrl=http://partalog-ai:8000
AiService__Endpoints__ExtractTable=/api/table/extract-table
AiService__Endpoints__DetectHotspots=/api/detect

CatalogAiProcessing__MaxAttempts=3
CatalogAiProcessing__BaseRetryDelaySeconds=2
CatalogAiProcessing__PollIntervalSeconds=2
CatalogAiProcessing__LeaseSeconds=300

# Catalog-only hard gates
ProductFeatures__EnableAi=false
ProductFeatures__EnableEcommerce=false
ProductFeatures__EnableUpgradePrompts=false
