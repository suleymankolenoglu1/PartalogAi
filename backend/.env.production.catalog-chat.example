# Catalog + grounded chat production environment template
# Copy values into Secret Manager / Cloud Run. Never commit real secrets.

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__DefaultConnection=Host=CHANGE_ME;Port=5432;Database=KatalogcuDb;Username=CHANGE_ME;Password=CHANGE_ME;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=20;Timeout=15;Command Timeout=30;Max Auto Prepare=0

JwtSettings__SecretKey=CHANGE_ME_MIN_32_CHARS
JwtSettings__Issuer=KatalogcuAPI
JwtSettings__Audience=KatalogcuFrontend
JwtSettings__ExpirationMinutes=60

PublicLink__SecretKey=CHANGE_ME_MIN_32_CHARS
PublicLink__Issuer=KatalogcuPublic
PublicLink__Audience=KatalogcuPublic
PublicLink__ExpirationDays=365

Cors__AllowedOrigins__0=https://CHANGE_ME_FRONTEND_DOMAIN
Frontend__BaseUrl=https://CHANGE_ME_FRONTEND_DOMAIN
RequestLimits__DefaultMaxBodySizeMb=50

# Private Cloud Run AI service. Audience is the service origin without a path.
AiService__BaseUrl=https://CHANGE_ME_AI_SERVICE.run.app
AiService__UseCloudRunIdentityToken=true
AiService__CloudRunAudience=https://CHANGE_ME_AI_SERVICE.run.app
AiService__ChatTimeoutSeconds=45
AiService__StreamTimeoutSeconds=90
AiService__LongRunningTimeoutSeconds=300
AiService__EnableItemEmbeddings=true
AiService__EmbeddingTimeoutSeconds=20

# Catalog + chat MVP gates. Ecommerce remains outside this release.
ProductFeatures__EnableChatbot=true
ProductFeatures__EnableCatalogAnalysis=true
ProductFeatures__EnableEcommerce=false
ProductFeatures__EnableUpgradePrompts=false
ProductFeatures__EnablePlanManagement=false

# Multi-instance chat safety: Redis is mandatory and fail-closed.
DistributedRateLimits__RedisPublicChatEnabled=true
DistributedRateLimits__RedisConnectionString=CHANGE_ME_REDIS_CONNECTION
DistributedRateLimits__RedisKeyPrefix=partalog:rate-limit
DistributedRateLimits__PublicChatPermitLimit=20
DistributedRateLimits__PublicChatWindowSeconds=60
DistributedRateLimits__FailOpen=false

AiCapacity__Provider=Redis
AiCapacity__GlobalConcurrentChats=100
AiCapacity__PerUserConcurrentChats=3
AiCapacity__AcquireTimeoutMs=500
AiCapacity__RedisConnectionString=CHANGE_ME_REDIS_CONNECTION
AiCapacity__DistributedPoolName=api-chat

DataProtection__Provider=Redis
DataProtection__RedisConnectionString=CHANGE_ME_REDIS_CONNECTION
DataProtection__RedisKey=partalog:data-protection:keys
DataProtection__KeyEncryptionKey=CHANGE_ME_BASE64_32_BYTE_KEY

FileStorage__Provider=GoogleCloudStorage
FileStorage__BucketName=CHANGE_ME_ASSETS_BUCKET
FileStorage__PublicBaseUrl=https://storage.googleapis.com/CHANGE_ME_ASSETS_BUCKET

CatalogAiProcessing__MaxAttempts=4
CatalogAiProcessing__BaseRetryDelaySeconds=15
CatalogAiProcessing__HangfireWorkerCount=1

BackgroundProcessing__EnableCatalogAiServer=true
BackgroundProcessing__EnableExternalSiteCrawlServer=false
BackgroundProcessing__EnableDefaultServer=false
BackgroundProcessing__EnableRecurringJobs=false
Database__RunMigrationsOnStartup=false
