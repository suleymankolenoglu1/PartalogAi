{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=KatalogcuDb;Username=postgres;Password=YourPasswordHere"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyForJwtTokenGeneration123!",
    "Issuer": "KatalogcuAPI",
    "Audience": "KatalogcuUsers",
    "ExpirationMinutes": 60
  },
  "PublicLink": {
    "SecretKey": "YourPublicLinkSecretKeyHere!",
    "Issuer": "KatalogcuPublic",
    "Audience": "KatalogcuPublic",
    "ExpirationDays": 365
  },
  "EmbedAccessToken": {
    "SecretKey": "YourEmbedAccessTokenSecretKeyHere!",
    "Issuer": "KatalogcuEmbed",
    "Audience": "KatalogcuEmbed",
    "ExpirationMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "RequestLimits": {
    "DefaultMaxBodySizeMb": 50
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "Endpoints": {
      "ExtractTable": "/api/table/extract-table",
      "DetectHotspots": "/api/detect"
    }
  },
  "CatalogAiProcessing": {
    "MaxAttempts": 4,
    "BaseRetryDelaySeconds": 15,
    "HangfireWorkerCount": 1
  },
  "ErpGateway": {
    "DefaultProvider": "snapshot",
    "WebhookClients": [
      {
        "Name": "local-erp",
        "ApiKey": "CHANGE_ME_ERP_WEBHOOK_KEY",
        "OwnerUserId": "00000000-0000-0000-0000-000000000000",
        "Provider": "snapshot"
      }
    ]
  },
  "ProductFeatures": {
    "EnableAi": true,
    "EnableEcommerce": true,
    "EnableUpgradePrompts": true
  }
}
