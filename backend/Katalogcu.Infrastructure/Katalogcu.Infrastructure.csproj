<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Katalogcu.Application\Katalogcu.Application.csproj" />
    <ProjectReference Include="..\Katalogcu.Domain\Katalogcu.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.1" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="DotNetCore.NPOI" Version="1.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnablePlaywrightCrawler Condition="'$(EnablePlaywrightCrawler)' == ''">false</EnablePlaywrightCrawler>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnablePlaywrightCrawler)' != 'true'">
    <Compile Remove="Services/ExternalSitePlaywrightCrawler.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnablePlaywrightCrawler)' == 'true'">
    <Compile Remove="Services/ExternalSitePlaywrightCrawlerDisabled.cs" />
    <PackageReference Include="Microsoft.Playwright" Version="1.51.0" />
  </ItemGroup>

</Project>
